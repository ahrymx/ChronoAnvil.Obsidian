# Dependencies
node_modules/

# Build output. `npm run package` assembles the installable plugin folder
# here, and the three harness tools write their preview HTML here too.
dist/

# Generated by esbuild. NEVER committed — `.github/workflows/release.yml`
# builds it on a version tag and attaches it to the GitHub release, and the
# community installer downloads that asset rather than reading the repository
# tree. A main.js in git would be a copy that goes stale between builds.
main.js
main.js.map

# Generated from styles/*.css by tools/build-css.mjs on every build. Edit the
# files in styles/, never this one — it is overwritten. It ships in the plugin
# folder and in the release assets, but a copy in git would go stale the first
# time someone edited a part file and did not rebuild.
styles.css

# Generated from assets/ by tools/build-assets.mjs, and compiled INTO main.js so
# the shipped notes reach an install that has no assets/ folder — which is every
# install that came from the community store. Edit the markdown in assets/; this
# module is overwritten on every build, and a committed copy would be a second
# spelling of three files that already live in the repository.
generated/

# Not for publication. A commercial strategy is a private working document,
# and this repository is about to be public; the line stays after the file is
# removed so that a copy landing back in the tree is not a commit away from
# being published.
commercialise.md

# Test and tooling artefacts
coverage/
.eslintcache
*.tgz

# `docs/` holds generated reference output and is not committed — but the
# README's Visual Tour points into `docs/screenshots/`, and an image git never
# takes is the broken-gallery bug this line would otherwise cause a second time.
# Written as `docs/*` rather than `docs/` DELIBERATELY: git cannot re-include a
# file whose parent DIRECTORY is excluded, so ignoring the directory itself
# would make the negation below silently do nothing.
docs/*
!docs/screenshots/

# Credentials. Nothing in this project reads an environment file today; the
# line is here so that the day something does, the file is already ignored.
.env
.env.*
!.env.example

# Editors
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
